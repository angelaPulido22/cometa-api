MONGODB_URI=mongodb://localhost:27017
DB_NAME=cometa
# Cambia esto por una frase larga y secreta (distinta en producción)
JWT_SECRET=cambia-esto-por-un-secreto-largo
# Zona horaria del club (para calcular "vence hoy" / "vencido")
ZONA_HORARIA=America/Bogota
# En Render/Railway/etc. pon 1
TRUST_PROXY=0
